# ---- Server ----
PORT=3000
NODE_ENV=development
# Public HTTPS URL of this server (ElevenLabs, Paystack and WhatsApp must reach it). Use ngrok in development.
PUBLIC_URL=https://your-domain.example.com
# Protects /admin/* (onboarding by hand, adding phone numbers to the pool)
ADMIN_KEY=change-me
# Pickam staff phone: gets an SMS when e.g. the phone number pool runs out
ADMIN_PHONE=
# On Railway, point this at the mounted volume, e.g. /data/pickam.db
DATABASE_PATH=data/pickam.db
# false = landing page collects early-access (waitlist) sign-ups; true = buttons go straight to signup
SIGNUPS_OPEN=false

# ---- ElevenLabs (voice agent, outbound callbacks, voice-note transcription) ----
ELEVENLABS_API_KEY=
# Default voice for new agents. Pick a warm Nigerian-English voice from the Voice Library.
ELEVENLABS_DEFAULT_VOICE_ID=
# Leave empty to use ElevenLabs' default model
ELEVENLABS_LLM=
# Secret from ElevenLabs > Agents > Settings > Post-call webhook
ELEVENLABS_WEBHOOK_SECRET=

# ---- Website "Talk to Ada" demo (needs ELEVENLABS_API_KEY; each call costs ElevenLabs minutes) ----
DEMO_ENABLED=true
# Max calls per day across all visitors (cost cap), per visitor per hour, and max call length
DEMO_DAILY_CALL_LIMIT=50
DEMO_CALLS_PER_VISITOR_PER_HOUR=3
DEMO_MAX_CALL_SECONDS=120

# First N businesses to buy a plan get their first month half price (0 = off)
FOUNDING_SLOTS=100

# ---- Nigerian SIP trunk (numbers are imported into ElevenLabs with these) ----
SIP_TRUNK_ADDRESS=
SIP_TRUNK_USERNAME=
SIP_TRUNK_PASSWORD=

# ---- Africa's Talking (login codes, SMS alerts, payment links to customers) ----
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# ---- WhatsApp Cloud API (owner alerts, replies, voice notes, daily summary) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any string; enter the same value in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# Approved template with body "{{1}}\n\n{{2}}"
WHATSAPP_ALERT_TEMPLATE=pickam_alert
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---- Paystack (plans, wallet top-ups, customer payment links) ----
PAYSTACK_SECRET_KEY=
# Pickam's cut of order payments (percent). 0 = free for now.
PAYSTACK_ORDER_FEE_PERCENT=0
