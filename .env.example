# Server
PORT=3000
# Public HTTPS URL of this server (ElevenLabs must be able to reach it). Use ngrok in development.
PUBLIC_URL=https://your-domain.example.com
# Protects POST /admin/businesses (onboarding new customers)
ADMIN_KEY=change-me
DATABASE_PATH=data/pickam.db

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
# Default voice for new agents. Pick a warm Nigerian-English voice from the Voice Library.
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_LLM=gpt-4o-mini
# Secret from ElevenLabs > Agents > Settings > Post-call webhook
ELEVENLABS_WEBHOOK_SECRET=

# Africa's Talking (SMS alerts to business owners)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
